{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    "paths": {
      "moon-discord": ["./src/index.ts"],
      "moon-discord/rest": ["./src/rest.ts"],
      "moon-discord/testing": ["./src/testing.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
